PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role-equivalent -- server-only, NEVER prefix with PUBLIC_ (Vite would
# bundle it into client JS). Used by one-off admin scripts, not by the app itself.
SUPABASE_SECRET_KEY=your-service-role-key

# Base URL images are served from once uploaded to R2 via functions/api/upload.ts
# (see that file + supabase/schema.sql). Set this to your R2 bucket's public
# r2.dev URL or connected custom subdomain, e.g. https://media.yourdomain.com
# -- no trailing slash. photo_url/logo_url columns store only the object KEY
# (e.g. providers/some-slug/hero.webp); this env var + that key is how pages
# build the full <img> src. The upload function itself needs no env var here --
# it authenticates via the MEDIA_BUCKET R2 binding configured on the Pages
# project (Settings -> Functions -> R2 bucket bindings), not an API key.
PUBLIC_R2_BASE_URL=https://media.yourdomain.com
