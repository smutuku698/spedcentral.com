---
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { ArrowRight } from "lucide-react";
---
<Layout title="Page Not Found | SpedCentral" description="This page couldn't be found." noindex>
  <SiteHeader />

  <div class="mx-auto max-w-2xl px-6 py-24 text-center">
    <p class="text-sm font-semibold text-brand-orange">404</p>
    <h1 class="mt-2 text-3xl font-bold text-brand-dark">We couldn't find that page</h1>
    <p class="mt-4 text-brand-dark/80">
      It may have moved, or the specialty/product you're looking for hasn't been added to Houston yet.
      Here's where to go instead:
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
      <a href="/texas/houston/" class="inline-flex items-center justify-center rounded-md bg-brand-orange px-6 py-3 font-semibold text-white hover:opacity-90">
        Find a provider <ArrowRight className="ml-1 h-4 w-4" />
      </a>
      <a href="/products/" class="inline-flex items-center justify-center rounded-md border border-border px-6 py-3 font-semibold text-brand-dark hover:border-brand-orange">
        Shop products
      </a>
      <a href="/search/" class="inline-flex items-center justify-center rounded-md border border-border px-6 py-3 font-semibold text-brand-dark hover:border-brand-orange">
        Search SpedCentral
      </a>
    </div>
  </div>

  <SiteFooter />
</Layout>
