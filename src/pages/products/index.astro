---
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import ProductCard from "@/components/ProductCard.astro";
import ProductCategorySidebar from "@/components/ProductCategorySidebar.astro";
import { ArrowRight } from "lucide-react";
import { getPublishedProducts, getProductCategoryBySlug } from "@/lib/data";
import { breadcrumbJsonLd } from "@/lib/seo";

const products = await getPublishedProducts();
const productCards = await Promise.all(
  products.map(async (p) => ({ p, category: await getProductCategoryBySlug(p.category_slugs[0]) })),
);

const breadcrumbs = breadcrumbJsonLd([{ name: "Home", url: "/" }, { name: "Products", url: "/products/" }], Astro.site!);
---
<Layout
  title="Shop SPED Products & Tools | SpedCentral"
  description="Sensory tools, assistive technology, adaptive classroom supplies, and daily-living aids for special education students, teachers, and adults."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} slot="head" is:inline />
  <SiteHeader />

  <nav class="border-b border-border bg-white py-3 text-xs text-muted-foreground">
    <div class="mx-auto max-w-7xl px-6">
      <a href="/" class="hover:text-brand-orange">Home</a> /
      <span class="text-brand-dark">Products</span>
    </div>
  </nav>

  <header class="bg-cream py-12">
    <div class="mx-auto max-w-7xl px-6">
      <h1 class="text-3xl font-bold text-brand-dark md:text-4xl">Tools &amp; Products for Every Learner</h1>
      <p class="mt-4 max-w-3xl text-brand-dark/80">
        Sensory tools, assistive technology, adaptive classroom supplies, and daily-living aids -- picked for real
        impact, organized by category.
      </p>
    </div>
  </header>

  <div class="mx-auto max-w-7xl px-6 py-12 lg:flex lg:items-start lg:gap-10">
    <ProductCategorySidebar />

    <div class="flex-1">
      <p class="text-sm text-muted-foreground">{products.length} {products.length === 1 ? "product" : "products"}</p>
      <div class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-3">
        {productCards.map(({ p, category }) => <ProductCard product={p} category={category} />)}
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 pb-16">
    <div class="rounded-lg bg-cream p-8 text-center">
      <h2 class="text-xl font-bold text-brand-dark">Make something families need?</h2>
      <p class="mt-2 text-sm text-muted-foreground">List an affiliate product or sell your own printables and digital resources on SpedCentral.</p>
      <a href="/sell-your-products/" class="mt-4 inline-flex items-center rounded-md bg-brand-orange px-6 py-2.5 font-semibold text-white hover:opacity-90">
        Sell on SpedCentral <ArrowRight className="ml-1 h-4 w-4" />
      </a>
    </div>
  </div>

  <SiteFooter />
</Layout>
