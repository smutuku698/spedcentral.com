---
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import ProductCard from "@/components/ProductCard.astro";
import ProductCategorySidebar from "@/components/ProductCategorySidebar.astro";
import { PackageSearch } from "lucide-react";
import {
  getProductCategoryBySlug, getProductsByCategory, getProductCategoryFaqs, getProductCategoryGroups,
} from "@/lib/data";
import { breadcrumbJsonLd, itemListJsonLd } from "@/lib/seo";

// Every group gets a real page, even ones with zero products yet -- the
// sidebar links to all 9 unconditionally, so an inactive one needs
// somewhere to land instead of a 404. See the empty state below for how
// a category with nothing in it yet actually reads to a visitor.
export async function getStaticPaths() {
  const groups = await getProductCategoryGroups();
  return Promise.all(
    groups.map(async (c) => ({
      params: { category: c.slug },
      props: { products: await getProductsByCategory(c.slug) },
    })),
  );
}

const { category: categorySlug } = Astro.params;
const { products } = Astro.props;
const category = (await getProductCategoryBySlug(categorySlug!))!;
const faqs = getProductCategoryFaqs(category.slug);
const breadcrumbs = breadcrumbJsonLd(
  [
    { name: "Home", url: "/" },
    { name: "Products", url: "/products/" },
    { name: category.name, url: `/products/${category.slug}/` },
  ],
  Astro.site!,
);
const productList = itemListJsonLd(
  products.map((p) => ({ name: p.name, url: `/products/item/${p.slug}/` })),
  Astro.site!,
);

const productCards = await Promise.all(
  products.map(async (p) => ({ p, category: await getProductCategoryBySlug(p.category_slugs[0]) })),
);
---
<Layout
  title={`${category.name} | SpedCentral`}
  description={category.meta_description ?? `Browse ${category.name} products on SpedCentral.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} slot="head" is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(productList)} slot="head" is:inline />
  <SiteHeader />

  <nav class="border-b border-border bg-white py-3 text-xs text-muted-foreground">
    <div class="mx-auto max-w-7xl px-6">
      <a href="/" class="hover:text-brand-orange">Home</a> /
      <a href="/products/" class="hover:text-brand-orange">Products</a> /
      <span class="text-brand-dark">{category.name}</span>
    </div>
  </nav>

  <header class="bg-cream py-12">
    <div class="mx-auto max-w-7xl px-6">
      <h1 class="text-3xl font-bold text-brand-dark md:text-4xl">{category.name}</h1>
      <p class="mt-4 max-w-3xl text-brand-dark/80">{category.short_description}</p>
      <p class="mt-3 text-sm font-semibold text-brand-green">{products.length} {products.length === 1 ? "product" : "products"}</p>
    </div>
  </header>

  <div class="mx-auto max-w-7xl px-6 py-12 lg:flex lg:items-start lg:gap-10">
    <ProductCategorySidebar activeSlug={category.slug} />

    <div class="flex-1">
      {products.length > 0 ? (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-3">
          {productCards.map(({ p, category: leafCategory }) => <ProductCard product={p} category={leafCategory} />)}
        </div>
      ) : (
        <div class="rounded-lg border border-dashed border-border bg-cream/50 p-12 text-center">
          <PackageSearch className="mx-auto h-10 w-10 text-brand-orange" />
          <p class="mt-4 font-semibold text-brand-dark">We're currently adding products to this category.</p>
          <p class="mt-2 text-sm text-muted-foreground">Check back soon, or browse everything we have so far.</p>
          <a href="/products/" class="mt-4 inline-flex items-center rounded-md bg-brand-orange px-5 py-2 text-sm font-semibold text-white hover:opacity-90">
            Browse all products
          </a>
        </div>
      )}

      {faqs.length > 0 && (
        <section class="mt-16 max-w-3xl">
          <h2 class="text-2xl font-bold text-brand-dark">Frequently asked questions</h2>
          <div class="mt-6 space-y-5">
            {faqs.map((f) => (
              <div>
                <p class="font-semibold text-brand-dark">{f.question}</p>
                <p class="mt-1 text-sm text-brand-dark/80">{f.answer}</p>
              </div>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>

  <SiteFooter />
</Layout>
