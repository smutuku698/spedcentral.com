---
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { Star, Download } from "lucide-react";
import {
  getProductCategoryBySlug, getProductsByCategory, getProductCategoryFaqs, getActiveProductCategoryGroups,
} from "@/lib/data";
import { productIcons } from "@/lib/icons";
import { breadcrumbJsonLd, itemListJsonLd } from "@/lib/seo";

// Same rule as the service category pages: only publish a hub page once
// there's at least one real product in it. getActiveProductCategoryGroups()
// is the same function the homepage chips and footer use.
export function getStaticPaths() {
  return getActiveProductCategoryGroups().map((c) => ({
    params: { category: c.slug },
    props: { products: getProductsByCategory(c.slug) },
  }));
}

const { category: categorySlug } = Astro.params;
const { products } = Astro.props;
const category = getProductCategoryBySlug(categorySlug!)!;
const faqs = getProductCategoryFaqs(category.slug);
const breadcrumbs = breadcrumbJsonLd(
  [
    { name: "Home", url: "/" },
    { name: "Products", url: "/products/" },
    { name: category.name, url: `/products/${category.slug}/` },
  ],
  Astro.site!,
);
const productList = itemListJsonLd(
  products.map((p) => ({ name: p.name, url: `/products/item/${p.slug}/` })),
  Astro.site!,
);
---
<Layout
  title={`${category.name} | SpedCentral`}
  description={category.meta_description ?? `Browse ${category.name} products on SpedCentral.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} slot="head" is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(productList)} slot="head" is:inline />
  <SiteHeader />

  <nav class="border-b border-border bg-white py-3 text-xs text-muted-foreground">
    <div class="mx-auto max-w-6xl px-6">
      <a href="/" class="hover:text-brand-orange">Home</a> /
      <a href="/products/" class="hover:text-brand-orange">Products</a> /
      <span class="text-brand-dark">{category.name}</span>
    </div>
  </nav>

  <header class="bg-cream py-12">
    <div class="mx-auto max-w-6xl px-6">
      <h1 class="text-3xl font-bold text-brand-dark md:text-4xl">{category.name}</h1>
      <p class="mt-4 max-w-3xl text-brand-dark/80">{category.short_description}</p>
      <p class="mt-3 text-sm font-semibold text-brand-green">{products.length} {products.length === 1 ? "product" : "products"}</p>
    </div>
  </header>

  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {products.map((p) => {
        const Icon = productIcons[p.image_icon];
        return (
          <a href={`/products/item/${p.slug}/`} class="group flex flex-col overflow-hidden rounded-lg border border-border bg-white shadow-sm transition hover:shadow-md">
            <div class={`relative flex h-28 items-center justify-center ${p.image_tint}`}>
              {Icon && <Icon className="h-10 w-10 text-brand-dark/70" />}
              {p.product_type === "digital_download" && (
                <span class="absolute left-3 top-3 inline-flex items-center gap-1 rounded-full bg-white/95 px-2 py-0.5 text-[10px] font-semibold text-brand-dark">
                  <Download className="h-3 w-3" /> Instant Download
                </span>
              )}
            </div>
            <div class="flex flex-1 flex-col p-4">
              <h2 class="font-bold leading-snug text-brand-dark group-hover:text-brand-orange">{p.name}</h2>
              <p class="mt-1 text-xs text-muted-foreground">by {p.brand}</p>
              <p class="mt-2 flex-1 text-xs text-brand-dark/80">{p.short_description}</p>
              <div class="mt-3 flex items-center justify-between">
                <span class="font-bold text-brand-dark">${p.price.toFixed(2)}</span>
                <span class="flex items-center gap-1 text-xs text-brand-dark">
                  <Star className="h-3.5 w-3.5 fill-brand-orange text-brand-orange" />
                  {p.rating_avg} <span class="text-muted-foreground">({p.review_count})</span>
                </span>
              </div>
            </div>
          </a>
        );
      })}
    </div>

    {faqs.length > 0 && (
      <section class="mt-16 max-w-3xl">
        <h2 class="text-2xl font-bold text-brand-dark">Frequently asked questions</h2>
        <div class="mt-6 space-y-5">
          {faqs.map((f) => (
            <div>
              <p class="font-semibold text-brand-dark">{f.question}</p>
              <p class="mt-1 text-sm text-brand-dark/80">{f.answer}</p>
            </div>
          ))}
        </div>
      </section>
    )}
  </div>

  <SiteFooter />
</Layout>
