---
import { ArrowRight } from "lucide-react";
---
<section class="relative overflow-hidden bg-brand-orange py-12">
  <div class="absolute -left-10 top-0 h-32 w-32 rotate-45 bg-brand-green"></div>
  <div class="absolute -right-10 top-0 h-32 w-32 rotate-45 bg-brand-yellow"></div>
  <div class="relative mx-auto max-w-3xl px-6 text-center">
    <h2 class="text-2xl font-bold text-white">Are you a provider or specialist in special education?</h2>
    <p class="mt-2 text-sm text-white/90">List your practice on SpedCentral and get discovered by families searching for exactly what you offer.</p>
    <a href="/list-your-practice/" class="mt-5 inline-flex items-center rounded-md bg-white px-6 py-2.5 font-semibold text-brand-dark hover:bg-white/90">
      Get listed <ArrowRight className="ml-1 h-4 w-4" />
    </a>
  </div>
</section>
