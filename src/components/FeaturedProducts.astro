---
// Reads from src/data/*.json via src/lib/data.ts today -- see the note at
// the top of that file for how this becomes a real Supabase call later
// without this component needing to change.
import { Star, Download } from "lucide-react";
import { getFeaturedProducts, getProductCategoryGroups, getProductCategoryBySlug } from "@/lib/data";
import { productIcons } from "@/lib/icons";

const productGroups = getProductCategoryGroups();
const featured = getFeaturedProducts(4);

// Same restrained top-edge accent system as FeaturedProviders -- reused
// on purpose, so both grids read as one consistent design system.
const accents = ["bg-brand-orange", "bg-brand-purple", "bg-brand-green", "bg-brand-pink"];
---
<section class="bg-cream py-16">
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-3xl font-bold text-brand-dark">Featured products</h2>
        <p class="mt-2 text-sm text-muted-foreground">Sponsored placements from brands and creators. Browse the full catalog for every option, sponsored or not.</p>
      </div>
      <a href="/products/" class="text-sm font-semibold text-brand-orange hover:underline">Shop all products &rarr;</a>
    </div>

    <div class="mt-6 flex flex-wrap gap-2">
      {productGroups.map((g) => (
        <a href={`/products/${g.slug}/`} class="rounded-full border border-border bg-white px-3 py-1.5 text-xs font-semibold text-brand-dark hover:border-brand-orange hover:text-brand-orange">
          {g.name}
        </a>
      ))}
    </div>

    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {featured.map((p, i) => {
        const Icon = productIcons[p.image_icon];
        const category = getProductCategoryBySlug(p.category_slugs[0]);
        return (
          <a href={`/products/item/${p.slug}/`} class="group flex flex-col overflow-hidden rounded-lg border border-border bg-white shadow-sm transition hover:shadow-md">
            <div class={`h-[3px] w-full ${accents[i % accents.length]}`}></div>
            <div class={`relative flex h-28 items-center justify-center ${p.image_tint}`}>
              {Icon && <Icon className="h-10 w-10 text-brand-dark/70" />}
              <span class="absolute left-3 top-3 rounded border border-black/10 bg-white/95 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-muted-foreground">
                Sponsored
              </span>
            </div>
            <div class="flex flex-1 flex-col p-4">
              <div class="flex items-center justify-between gap-2">
                <p class="text-xs font-semibold text-brand-green">{category?.name}</p>
                {p.product_type === "digital_download" && (
                  <span class="inline-flex flex-shrink-0 items-center gap-1 rounded-full bg-brand-dark/5 px-2 py-0.5 text-[10px] font-semibold text-brand-dark">
                    <Download className="h-3 w-3" /> Instant Download
                  </span>
                )}
              </div>
              <h3 class="mt-1 font-bold leading-snug text-brand-dark group-hover:text-brand-orange">{p.name}</h3>
              <p class="mt-1 text-xs text-muted-foreground">by {p.brand}</p>
              <p class="mt-2 flex-1 text-xs text-brand-dark/80">{p.short_description}</p>
              <div class="mt-3 flex items-center justify-between">
                <span class="font-bold text-brand-dark">${p.price.toFixed(2)}</span>
                <span class="flex items-center gap-1 text-xs text-brand-dark">
                  <Star className="h-3.5 w-3.5 fill-brand-orange text-brand-orange" />
                  {p.rating_avg} <span class="text-muted-foreground">({p.review_count})</span>
                </span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
