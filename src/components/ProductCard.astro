---
import { Star, Download } from "lucide-react";
import { productIcons } from "@/lib/icons";
import type { Product, Category } from "@/lib/data";

interface Props {
  product: Product;
  category: Category | null;
  // top-edge accent stripe + "Sponsored" badge -- reserved for paid
  // placements (homepage featured section), never the general catalog, so
  // "Sponsored" never shows on a product that isn't actually one.
  accentClass?: string;
  sponsored?: boolean;
}

const { product, category, accentClass, sponsored = false } = Astro.props;
const Icon = productIcons[product.image_icon];
---
<a href={`/products/item/${product.slug}/`} class="group flex flex-col overflow-hidden rounded-lg border border-border bg-white shadow-sm transition hover:shadow-md">
  {accentClass && <div class={`h-[3px] w-full ${accentClass}`}></div>}
  <div class={`relative flex h-40 items-center justify-center ${product.image_tint}`}>
    {Icon && <Icon className="h-12 w-12 text-brand-dark/70" />}
    {sponsored && (
      <span class="absolute left-3 top-3 rounded border border-black/10 bg-white/95 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-muted-foreground">
        Sponsored
      </span>
    )}
    {product.product_type === "digital_download" && (
      <span class="absolute right-3 top-3 inline-flex items-center gap-1 rounded-full bg-white/95 px-2 py-0.5 text-[10px] font-semibold text-brand-dark">
        <Download className="h-3 w-3" /> Instant Download
      </span>
    )}
  </div>
  <div class="flex flex-1 flex-col p-4">
    {category && <p class="text-xs font-semibold text-brand-green">{category.name}</p>}
    <h3 class="mt-1 font-bold leading-snug text-brand-dark group-hover:text-brand-orange">{product.name}</h3>
    <p class="mt-1 text-xs text-muted-foreground">by {product.brand}</p>
    <p class="mt-2 flex-1 text-xs text-brand-dark/80">{product.short_description}</p>
    <div class="mt-3 flex items-center justify-between">
      <span class="font-bold text-brand-dark">${(product.sale_price ?? product.price).toFixed(2)}</span>
      <span class="flex items-center gap-1 text-xs text-brand-dark">
        <Star className="h-3.5 w-3.5 fill-brand-orange text-brand-orange" />
        {product.rating_avg} <span class="text-muted-foreground">({product.review_count})</span>
      </span>
    </div>
  </div>
</a>
